# Hedera network: testnet | mainnet
HEDERA_NETWORK=testnet

# Merchant (resource server) — receives HBAR. ECDSA account from https://portal.hedera.com
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# Paying client (demo agent). Separate ECDSA account, funded with testnet HBAR.
HEDERA_PAYER_ID=
HEDERA_PAYER_KEY=

# Blocky402 facilitator. Do not build your own.
# testnet default: https://api.testnet.blocky402.com
# mainnet:         https://api.blocky402.com
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Public Hedera Mirror Node REST
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Optional HCS audit trail (Hedera extra point). Leave blank to skip.
HCS_TOPIC_ID=

# Merchant HTTP
PORT=4021
HOST=0.0.0.0

# Paying client target
FARE_BASE_URL=http://localhost:4021

# Demo client total budget (tinybars, digits only). Default 1000000 = 0.01 HBAR.
FARE_BUDGET_TINYBARS=1000000
